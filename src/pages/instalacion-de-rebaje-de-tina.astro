---
// instalacion-de-rebaje-de-tina.astro — Página del proceso de instalación a domicilio.
// La sección del video ("Así instalamos tu rebaje") vivía en el home y se movió acá.
import BaseLayout from '../layouts/BaseLayout.astro';
import InstalacionVideo from '../components/InstalacionVideo.astro';
import { SITE } from '../data/site';
import { faqNode } from '../lib/seo';
import { INSTALLATION_FEE } from '../lib/pricing';
import { clp } from '../lib/format';

const PASOS: { t: string; d: string }[] = [
  { t: 'Agendamos la visita', d: 'Coordinamos día y hora contigo. El técnico llega con la pieza y todas las herramientas: no tienes que comprar ni preparar materiales.' },
  { t: 'Medimos y protegemos', d: 'Se revisa la tina, se confirma el ancho del rebaje y se protege el piso y el entorno antes de empezar.' },
  { t: 'Cortamos la tina', d: 'Un corte preciso en una sección del borde, sin sacar la tina y sin tocar las cañerías, por lo que no hay riesgo de filtraciones.' },
  { t: 'Instalamos la pieza', d: 'Se retira el retazo cortado y se instala la pieza de fibra de vidrio reforzada, de fabricación nacional, certificada y patentada, con superficie antideslizante de fábrica.' },
  { t: 'Sellamos el rebaje', d: 'Se sella el contorno para que quede estanco y firme. Te indicamos cuánto esperar antes del primer uso.' },
  { t: 'Limpiamos y te explicamos', d: 'Retiramos los residuos de nuestro trabajo, dejamos el área limpia y te explicamos el uso y la mantención del rebaje.' },
];

const PREPARAR: string[] = [
  'Despejar el baño: cortina, alfombras y productos sobre el borde de la tina.',
  'Dejar libre el acceso desde la puerta principal hasta el baño.',
  'Tener un enchufe disponible cerca para las herramientas.',
  'Considerar que el baño no se podrá usar durante la instalación (menos de 2 horas).',
];

const FAQ: { q: string; a: string }[] = [
  { q: '¿Cuánto demora la instalación?', a: 'Menos de 2 horas en tu domicilio, normalmente el mismo día de la visita.' },
  { q: '¿Hay que hacer obras o romper el baño?', a: 'No. Adaptamos la tina que ya tienes en el lugar: no la sacamos, no tocamos cañerías ni cerámicas, y retiramos los residuos al terminar.' },
  { q: '¿Cuánto cuesta la instalación?', a: `La instalación tiene un cargo fijo de $${clp(INSTALLATION_FEE)} que se agrega al valor del rebaje cuando la solicitas en tu cotización.` },
  { q: '¿En qué regiones instalan?', a: 'Tenemos despacho e instalación en la Región Metropolitana, Valparaíso y Bío Bío. Para otras regiones, consúltanos por el servicio a tu zona.' },
  { q: '¿Qué garantía tiene el trabajo?', a: 'Entregamos 3 años de garantía sobre la pieza instalada, siguiendo las reglas de uso y mantención.' },
  { q: '¿Sirve para tinas de hidromasaje?', a: 'Sí. Instalamos rebajes en tinas tradicionales y de hidromasaje. Si no sabes qué tina tienes, el técnico la identifica en la visita.' },
];
---
<BaseLayout
  title="Instalación del rebaje de tina — Ducha Segura®"
  description="Así es la instalación del rebaje de tina de Ducha Segura®: a domicilio, en menos de 2 horas, sin obras ni filtraciones, con garantía de 3 años. Cobertura en RM, Valparaíso y Bío Bío."
  schema={faqNode(FAQ)}
>
  <section class="section">
    <div class="container">
      <header class="section-head section-head--center inst-intro">
        <span class="kicker">Servicio a domicilio</span>
        <h1 class="h2">Instalación del rebaje de tina</h1>
        <p class="lead">Vamos a tu casa, adaptamos la tina que ya tienes y te devolvemos el baño limpio y en uso <strong class="inst-em">en menos de 2 horas</strong>. Sin obras, sin escombros y con 3 años de garantía.</p>
      </header>

      <ul class="inst-facts">
        <li class="inst-fact reveal"><strong>Menos de 2 horas</strong><span>Instalación completa, el mismo día.</span></li>
        <li class="inst-fact reveal"><strong>Sin romper nada</strong><span>No sacamos la tina ni tocamos cañerías.</span></li>
        <li class="inst-fact reveal"><strong>3 años de garantía</strong><span>Sobre la pieza instalada.</span></li>
        <li class="inst-fact reveal"><strong>RM, Valparaíso y Bío Bío</strong><span>Otras regiones: consúltanos.</span></li>
      </ul>
    </div>
  </section>

  <InstalacionVideo />

  <section class="section section--soft">
    <div class="container">
      <header class="section-head section-head--center">
        <span class="kicker">Paso a paso</span>
        <h2 class="h2">Cómo es la instalación</h2>
      </header>
      <ol class="inst-steps">
        {PASOS.map((p, i) => (
          <li class="inst-step reveal">
            <span class="inst-step__n">{i + 1}</span>
            <div>
              <h3 class="inst-step__t">{p.t}</h3>
              <p class="inst-step__d">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container inst-narrow">
      <header class="section-head">
        <span class="kicker">Antes de la visita</span>
        <h2 class="h2">Qué tener listo</h2>
        <p class="lead">Nada complicado: con esto el técnico trabaja cómodo y termina a tiempo.</p>
      </header>
      <ul class="inst-check">
        {PREPARAR.map((item) => (
          <li class="inst-check__item">
            <svg class="ic inst-check__ic"><use href="#i-check"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="inst-note">La instalación tiene un cargo fijo de <strong>${clp(INSTALLATION_FEE)}</strong> que se suma al valor del rebaje al solicitarla en la cotización. ¿Dudas con tu caso? <a href={SITE.whatsappUrl} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>.</p>
      <div class="inst-cta">
        <a href="/cotizar" class="btn btn--primary btn--lg"><span>Cotizar mi rebaje</span><svg class="ic"><use href="#i-arrow"/></svg></a>
        <a href="/rebaje-de-tina" class="btn btn--ghost-dark btn--lg"><span>Ver rebajes</span></a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container inst-narrow">
      <header class="section-head">
        <span class="kicker">Ayuda</span>
        <h2 class="h2">Dudas sobre la instalación</h2>
        <p class="lead">¿Buscas algo más? Revisa las <a href="/preguntas-frecuentes/">preguntas frecuentes</a>.</p>
      </header>
      <div class="inst-faq">
        {FAQ.map((item) => (
          <details class="inst-faq__item">
            <summary class="inst-faq__q">
              <span>{item.q}</span>
              <svg class="ic inst-faq__chevron"><use href="#i-chevron"/></svg>
            </summary>
            <p class="inst-faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inst-intro{max-width:760px;margin-left:auto;margin-right:auto}
  .inst-em{color:var(--ds-blue);font-weight:700}
  .inst-narrow{max-width:820px}

  .inst-facts{list-style:none;margin:36px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  @media (max-width:880px){.inst-facts{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:480px){.inst-facts{grid-template-columns:1fr}}
  .inst-fact{background:#fff;border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);padding:20px;display:flex;flex-direction:column;gap:6px}
  .inst-fact strong{font-family:var(--ds-display);font-size:18px;color:var(--ds-text-strong);line-height:1.25}
  .inst-fact span{font-size:14.5px;line-height:1.5;color:var(--ds-text)}

  .inst-steps{list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  @media (max-width:880px){.inst-steps{grid-template-columns:1fr}}
  .inst-step{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);padding:22px}
  .inst-step__n{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:var(--ds-blue);color:#fff;font-family:var(--ds-display);font-weight:700;display:flex;align-items:center;justify-content:center}
  .inst-step__t{margin:0 0 6px;font-family:var(--ds-display);font-size:18px;color:var(--ds-text-strong);line-height:1.3}
  .inst-step__d{margin:0;font-size:15px;line-height:1.6;color:var(--ds-text)}

  .inst-check{list-style:none;margin:28px 0 0;padding:0;display:flex;flex-direction:column;gap:14px}
  .inst-check__item{display:flex;gap:12px;align-items:flex-start}
  .inst-check__ic{width:22px;height:22px;min-width:22px;stroke-width:2.5;color:#fff;background:var(--ds-blue);border-radius:50%;padding:4px;margin-top:1px}
  .inst-check__item span{font-size:15.5px;line-height:1.55;color:var(--ds-text-strong)}
  .inst-note{margin:26px 0 0;font-size:15px;line-height:1.6;color:var(--ds-text)}
  .inst-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}

  .inst-faq{display:flex;flex-direction:column;gap:12px;margin-top:28px}
  .inst-faq__item{border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);background:#fff;overflow:hidden;transition:border-color .15s,box-shadow .15s}
  .inst-faq__item[open]{border-color:var(--ds-blue-soft);box-shadow:var(--ds-shadow)}
  .inst-faq__q{display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer;list-style:none;padding:18px 20px;font-family:var(--ds-display);font-weight:700;font-size:18px;color:var(--ds-text-strong);line-height:1.3}
  .inst-faq__q::-webkit-details-marker{display:none}
  .inst-faq__q:focus-visible{outline:2px solid var(--ds-blue);outline-offset:2px}
  .inst-faq__chevron{width:20px;height:20px;min-width:20px;stroke-width:2.5;color:var(--ds-blue);transition:transform .2s}
  .inst-faq__item[open] .inst-faq__chevron{transform:rotate(180deg)}
  .inst-faq__a{margin:0;padding:0 20px 20px;font-size:15.5px;line-height:1.6;color:var(--ds-text)}
</style>
