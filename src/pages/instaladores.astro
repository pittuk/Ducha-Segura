---
// instaladores.astro — Landing de captación de Partners Locales (instaladores y
// prestadores de servicios independientes). Enfoque comercial: oportunidad de negocio
// con demanda ya generada por la marca. IMPORTANTE (legal): siempre "Partner",
// "prestador independiente" o "aliado comercial" — nunca términos de vínculo laboral.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { asset } from '../lib/asset';

// Misma pieza que muestra el home (Diferenciadores), pero en webp: el PNG original
// (NUEVA_1_sinfondo-3.png) pesa 650 KB y acá es el LCP; este webp pesa 40 KB.
const piezaImg = asset('/images/pieza-rebaje-ducha-segura.webp');

const BENEFICIOS: { icon: string; t: string; d: string }[] = [
  { icon: 'i-user', t: 'Demanda de clientes asegurada', d: 'Nosotros hacemos el marketing y captamos a los clientes en tu región; tú ejecutas la instalación.' },
  { icon: 'i-medal', t: 'Capacitación y certificación', d: 'Te capacitamos en la técnica operativa y en los estándares de la marca para que quedes 100% listo para operar desde el primer día.' },
  { icon: 'i-zap', t: 'Autonomía e independencia', d: 'Gestionas tus tiempos y tu agenda operando como prestador independiente, con el respaldo de una marca líder.' },
  { icon: 'i-shield', t: 'Soporte comercial y garantía', d: 'Cuentas con nuestro acompañamiento técnico y con el respaldo de garantía que le da confianza al cliente final.' },
];

const ZONAS: { zona: string; territorios: { region: string; comunas: string[] }[] }[] = [
  { zona: 'Zona Norte', territorios: [
    { region: 'Arica y Parinacota', comunas: ['Arica'] },
    { region: 'Tarapacá', comunas: ['Iquique', 'Alto Hospicio'] },
    { region: 'Antofagasta', comunas: ['Antofagasta', 'Calama', 'Tocopilla'] },
    { region: 'Atacama', comunas: ['Copiapó', 'Vallenar'] },
    { region: 'Coquimbo', comunas: ['La Serena', 'Coquimbo', 'Ovalle', 'Illapel'] },
  ] },
  { zona: 'Zona Centro', territorios: [
    { region: 'O’Higgins', comunas: ['Rancagua', 'Machalí', 'Rengo', 'San Fernando', 'Pichilemu'] },
    { region: 'Maule', comunas: ['Talca', 'Curicó', 'Linares', 'Constitución'] },
    { region: 'Ñuble y Biobío', comunas: ['Chillán', 'Los Ángeles'] },
  ] },
  { zona: 'Zona Sur', territorios: [
    { region: 'Los Ríos', comunas: ['Valdivia', 'La Unión', 'Río Bueno'] },
    { region: 'Los Lagos', comunas: ['Osorno', 'Puerto Montt', 'Puerto Varas', 'Castro', 'Ancud'] },
    { region: 'Magallanes', comunas: ['Punta Arenas', 'Puerto Natales'] },
  ] },
];

const waPartner = SITE.whatsappUrl + '?text=' + encodeURIComponent('Hola Ducha Segura® 👋 Quiero información para ser Partner instalador en mi zona.');
---
<BaseLayout
  title="Sé Partner de Ducha Segura® — Red nacional de instaladores"
  description="¿Eres instalador? Súmate como Partner Local de Ducha Segura®: clientes captados por la marca en tu ciudad, capacitación y certificación, y un modelo probado de alta demanda. Postula tu zona."
>
  <!-- 1. Hero -->
  <section class="section section--dark part-hero">
    <div class="container part-hero__inner">
      <div class="part-hero__copy">
        <div class="part-hero__top">
          <span class="kicker part-hero__kicker">Red nacional de Partners</span>
          <span class="part-hero__badge">Cupos limitados por zona</span>
        </div>
        <h1 class="h2 part-hero__title">¿Eres instalador y quieres <span class="part-hero__em">aumentar tus ingresos?</span></h1>
        <p class="lead part-hero__lead">Convierte tu experiencia en un negocio rentable. Súmate como <strong>Partner Local de Ducha Segura®</strong>, accede a proyectos en tu ciudad y opera con un modelo probado de alta demanda. Pioneros en el rebaje de tina en Chile.</p>
        <div class="part-hero__cta">
          <a class="btn btn--primary btn--lg" href="#postular">Quiero ser Partner / Postular mi zona</a>
          <a class="btn btn--wa btn--lg" href={waPartner} target="_blank" rel="noopener">
            <svg class="ic"><use href="#i-whatsapp"/></svg>
            <span>Consultar por WhatsApp</span>
          </a>
        </div>
        <ul class="part-hero__facts">
          <li><strong>+6 años</strong><span>de marca en el mercado</span></li>
          <li><strong>Producto patentado</strong><span>de fabricación nacional</span></li>
          <li><strong>Cobertura nacional</strong><span>cupos limitados por zona</span></li>
        </ul>
      </div>

      <div class="part-hero__media">
        <img src={piezaImg} alt="Pieza de rebaje de tina Ducha Segura®, el producto que instalan nuestros Partners" width="620" height="620" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- 2. Beneficios -->
  <section class="section">
    <div class="container">
      <header class="section-head section-head--center">
        <span class="kicker">Modelo de negocio</span>
        <h2 class="h2">Por qué sumar tu negocio a <span class="accent">Ducha Segura®</span></h2>
        <p class="lead">Un modelo llave en mano: la marca genera la demanda y te entrega la técnica; tú operas con tu propio negocio.</p>
      </header>
      <div class="part-grid">
        {BENEFICIOS.map((b) => (
          <article class="part-card reveal">
            <span class="part-card__ic"><svg class="ic"><use href={`#${b.icon}`}/></svg></span>
            <h3 class="part-card__t">{b.t}</h3>
            <p class="part-card__d">{b.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Capacitación e insumos -->
  <section class="section section--soft">
    <div class="container part-cap">
      <div class="part-cap__media reveal">
        <!-- Video vertical (720x1280). Controles nativos: no necesita JS.
             El poster es el frame del segundo 11.2 ("Se trabaja sobre la misma tina"),
             extraído del propio video con ffmpeg. -->
        <video class="part-cap__video" controls preload="metadata" playsinline
               poster={asset('/videos/capacitacion-instaladores-poster.webp')}>
          <source src={asset('/videos/capacitacion-instaladores-ducha-segura.mp4')} type="video/mp4" />
          Tu navegador no puede reproducir este video.
        </video>
      </div>

      <div class="part-cap__copy reveal">
        <span class="kicker">Todo puesto por la marca</span>
        <h2 class="h2">Te capacitamos y te pasamos <span class="accent">todos los insumos.</span></h2>
        <p class="lead">No necesitas invertir en aprender por tu cuenta ni salir a buscar materiales: capacitamos a cada Partner en la técnica de Ducha Segura® y le entregamos todo lo necesario para ejecutar el servicio.</p>
        <ul class="part-cap__list">
          <li><svg class="ic"><use href="#i-check"/></svg><span><strong>Capacitación completa</strong> en la técnica de corte, instalación y sellado, con los estándares de la marca.</span></li>
          <li><svg class="ic"><use href="#i-check"/></svg><span><strong>Todos los insumos</strong> necesarios para la instalación del servicio: la pieza y los materiales de trabajo.</span></li>
          <li><svg class="ic"><use href="#i-check"/></svg><span><strong>Acompañamiento técnico</strong> durante tus primeras instalaciones y soporte permanente después.</span></li>
        </ul>
        <a class="btn btn--primary btn--lg" href="#postular">Quiero capacitarme y postular</a>
      </div>
    </div>
  </section>

  <!-- 4. Cobertura -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-head section-head--center">
        <span class="kicker">Convocatoria abierta · cupos limitados</span>
        <h2 class="h2">Cobertura y territorios disponibles</h2>
        <p class="lead">Estas son las zonas donde estamos incorporando Partners. Asignamos un número acotado de cupos por territorio para no saturar la zona y se otorgan por orden de postulación. Si tu ciudad no aparece, postula igual: evaluamos nuevas aperturas.</p>
      </header>
      <div class="part-zonas">
        {ZONAS.map((z) => (
          <article class="part-zona reveal">
            <h3 class="part-zona__t">{z.zona}</h3>
            <ul class="part-zona__list">
              {z.territorios.map((t) => (
                <li>
                  <strong class="part-zona__region">{t.region}</strong>
                  <span class="part-zona__comunas">{t.comunas.map((c) => <span class="part-chip">{c}</span>)}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Formulario -->
  <section class="section" id="postular">
    <div class="container part-form-wrap">
      <header class="section-head section-head--center">
        <span class="kicker">Postulación</span>
        <h2 class="h2">Postula tu zona y evalúa tu incorporación a la red</h2>
        <p class="lead">Completa el formulario y nuestro equipo comercial te contactará para revisar la disponibilidad de tu territorio. <strong>Los cupos por zona son limitados</strong>: postular antes te da prioridad.</p>
      </header>

      <form class="part-form" id="postulacionForm" novalidate>
        <div class="part-form__row">
          <label>Nombre y apellido<input type="text" name="nombre" required autocomplete="name" /></label>
          <label>Teléfono / WhatsApp<input type="tel" name="telefono" required autocomplete="tel" /></label>
        </div>
        <label>Ciudad / Región donde operas<input type="text" name="zona" required autocomplete="address-level2" placeholder="Ej.: Valdivia, Los Ríos" /></label>
        <label>¿Tienes actividad o giro iniciado?
          <select name="actividad" required>
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="empresa">Sí, como empresa (giro y factura)</option>
            <option value="honorarios">Sí, como independiente (boleta de honorarios)</option>
            <option value="ninguna">Todavía no tengo actividad iniciada</option>
          </select>
        </label>
        <label>¿Cuentas con herramientas y medio de transporte propio?
          <select name="herramientas" required>
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="si">Sí</option>
            <option value="no">No</option>
          </select>
        </label>
        <label>Experiencia previa en servicios, instalaciones o remodelación
          <textarea name="experiencia" rows="4" placeholder="Cuéntanos brevemente en qué rubros has trabajado y hace cuánto tiempo."></textarea>
        </label>

        <!-- honeypot anti-spam -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="part-form__hp" aria-hidden="true" />

        <p class="part-form__error" id="postulacionError" role="alert" style="display:none"></p>
        <button class="btn btn--primary btn--lg btn--full" id="postulacionSubmit" type="submit">
          <svg class="ic"><use href="#i-mail"/></svg>
          <span>Enviar postulación</span>
        </button>
        <p class="part-form__legal">La incorporación es como <strong>prestador de servicios independiente</strong> o aliado comercial: no constituye una relación laboral de dependencia con Ducha Segura®. Al enviar aceptas nuestras <a href="/politicas-de-privacidad/">políticas de privacidad</a>.</p>
      </form>

      <div class="part-ok" id="postulacionOk" style="display:none" role="status">
        <div class="part-ok__ic"><svg class="ic"><use href="#i-check"/></svg></div>
        <h3 class="part-ok__t">¡Recibimos tu postulación!</h3>
        <p class="part-ok__d">Nuestro equipo comercial revisará la disponibilidad de tu territorio y te contactará al teléfono que nos dejaste.</p>
        <a class="btn btn--wa btn--lg" href={waPartner} target="_blank" rel="noopener">
          <svg class="ic"><use href="#i-whatsapp"/></svg>
          <span>Escríbenos por WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: dos columnas (copy + pieza). En móvil se apila y la imagen queda arriba. */
  .part-hero__inner{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
  @media (max-width:900px){.part-hero__inner{grid-template-columns:1fr;gap:28px}}
  .part-hero__top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .part-hero__kicker{color:rgba(255,255,255,.75)}
  .part-hero__badge{display:inline-block;padding:4px 12px;border-radius:999px;background:rgba(255,183,77,.16);border:1px solid rgba(255,183,77,.5);color:#ffc46b;font-size:12px;font-weight:700;letter-spacing:.03em;text-transform:uppercase}
  .part-hero__title{margin:8px 0 0}
  .part-hero__em{color:#4db4f0}
  .part-hero__lead{margin:16px 0 0;max-width:560px}
  .part-hero__cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .part-hero__facts{list-style:none;margin:36px 0 0;padding:0;display:flex;gap:12px;flex-wrap:wrap}
  .part-hero__facts li{flex:1 1 160px;max-width:240px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--ds-radius-lg);padding:16px}
  .part-hero__facts strong{display:block;font-family:var(--ds-display);font-size:17px;color:#fff}
  .part-hero__facts span{display:block;font-size:13px;color:rgba(255,255,255,.72);margin-top:4px}
  /* El PNG viene recortado (fondo transparente): un halo suave lo despega del azul. */
  .part-hero__media{position:relative;display:flex;align-items:center;justify-content:center}
  .part-hero__media::before{content:'';position:absolute;width:min(520px,80%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(77,180,240,.22),transparent 70%)}
  .part-hero__media img{position:relative;width:100%;max-width:560px;height:auto;display:block;filter:drop-shadow(0 24px 40px rgba(0,0,0,.35))}
  @media (max-width:900px){.part-hero__media{order:-1}.part-hero__media img{max-width:380px}}

  /* Beneficios */
  .part-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  @media (max-width:1024px){.part-grid{grid-template-columns:1fr 1fr}}
  @media (max-width:560px){.part-grid{grid-template-columns:1fr}}
  .part-card{background:#fff;border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);padding:26px 22px;box-shadow:var(--ds-shadow);transition:transform .2s,box-shadow .2s}
  .part-card:hover{transform:translateY(-3px);box-shadow:var(--ds-shadow-lg)}
  .part-card__ic{width:48px;height:48px;border-radius:12px;background:var(--ds-blue-soft);color:var(--ds-blue);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
  .part-card__ic .ic{width:24px;height:24px}
  .part-card__t{font-family:var(--ds-display);font-size:17px;font-weight:700;color:var(--ds-text-strong);margin:0 0 8px;line-height:1.25}
  .part-card__d{font-size:14px;line-height:1.55;color:var(--ds-text);margin:0}

  /* Capacitación e insumos: video vertical (9:16) + copy */
  .part-cap{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}
  @media (max-width:900px){.part-cap{grid-template-columns:1fr;gap:28px}}
  .part-cap__media{display:flex;justify-content:center}
  .part-cap__video{width:100%;max-width:320px;aspect-ratio:9/16;display:block;border-radius:var(--ds-radius-lg);box-shadow:var(--ds-shadow-lg);background:var(--ds-blue-dark);object-fit:cover}
  .part-cap__copy .lead{margin-top:14px}
  .part-cap__list{list-style:none;margin:24px 0 28px;padding:0;display:flex;flex-direction:column;gap:14px}
  .part-cap__list li{display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.55;color:var(--ds-text)}
  .part-cap__list .ic{width:20px;height:20px;min-width:20px;margin-top:2px;color:var(--ds-blue);stroke-width:2.5}
  .part-cap__list strong{color:var(--ds-text-strong)}

  /* Cobertura */
  .part-zonas{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media (max-width:900px){.part-zonas{grid-template-columns:1fr}}
  .part-zona{background:#fff;border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);padding:24px}
  .part-zona__t{font-family:var(--ds-display);font-size:18px;font-weight:800;color:var(--ds-blue);margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid var(--ds-blue-soft)}
  .part-zona__list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}
  .part-zona__region{display:block;font-size:13px;font-weight:800;color:var(--ds-text-strong);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
  .part-zona__comunas{display:flex;flex-wrap:wrap;gap:6px}
  .part-chip{display:inline-block;padding:4px 10px;border-radius:999px;background:var(--ds-blue-soft);color:var(--ds-blue-hover);font-size:12px;font-weight:600}

  /* Formulario */
  .part-form-wrap{max-width:680px}
  .part-form label{display:block;font-size:13px;font-weight:600;color:var(--ds-text-strong);margin:0 0 16px}
  .part-form input,.part-form select,.part-form textarea{display:block;width:100%;margin-top:5px;padding:10px 12px;border:1px solid var(--ds-border);border-radius:var(--ds-radius);font-family:var(--ds-sans);font-size:15px;font-weight:400;color:var(--ds-text-strong);background:#fff;outline:none;transition:border-color .15s}
  .part-form input:focus,.part-form select:focus,.part-form textarea:focus{border-color:var(--ds-blue)}
  .part-form__row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media (max-width:520px){.part-form__row{grid-template-columns:1fr}}
  .part-form__hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  .part-form__error{background:#fde8e8;color:var(--ds-red);border-radius:var(--ds-radius);padding:10px 12px;font-size:13px;font-weight:600;margin:0 0 12px}
  .part-form__legal{font-size:12px;color:var(--ds-text);margin:16px 0 0;text-align:center;line-height:1.5}
  .part-form__legal a{color:var(--ds-blue);text-decoration:underline}

  /* Confirmación (reemplaza al formulario tras enviar) */
  .part-ok{text-align:center;background:var(--ds-blue-soft);border:1px solid var(--ds-border);border-radius:var(--ds-radius-lg);padding:36px 24px}
  .part-ok__ic{width:60px;height:60px;margin:0 auto 18px;border-radius:50%;background:#fff;color:var(--ds-blue);display:flex;align-items:center;justify-content:center}
  .part-ok__ic .ic{width:28px;height:28px}
  .part-ok__t{font-family:var(--ds-display);font-size:22px;font-weight:800;color:var(--ds-text-strong);margin:0 0 10px}
  .part-ok__d{font-size:15px;color:var(--ds-text);margin:0 0 20px;line-height:1.6}
</style>
